<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B1A">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="18dp"
            android:paddingBottom="55dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="🧮 Bill Calculator"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Enter month, units used and rebate percentage."
                android:textColor="#C9D4E5"
                android:textSize="13sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_dashboard_card"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Month"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spMonth"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_box"
                    android:popupBackground="#071426" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Units Used (kWh)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etUnit"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_input_box"
                    android:hint="Example: 350"
                    android:inputType="number"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="#8CA0B8"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Minimum 1 kWh - Maximum 1000 kWh"
                    android:textColor="#9CA3AF"
                    android:textSize="12sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Rebate (%)"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="3"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btnRebate0"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="0%"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:backgroundTint="#FFC107" />

                    <Button
                        android:id="@+id/btnRebate1"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="1%"
                        android:textStyle="bold"
                        android:textColor="#020B1A"
                        android:backgroundTint="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRebate2"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="2%"
                        android:textStyle="bold"
                        android:textColor="#020B1A"
                        android:backgroundTint="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRebate3"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="3%"
                        android:textStyle="bold"
                        android:textColor="#020B1A"
                        android:backgroundTint="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRebate4"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="4%"
                        android:textStyle="bold"
                        android:textColor="#020B1A"
                        android:backgroundTint="#FFFFFF" />

                    <Button
                        android:id="@+id/btnRebate5"
                        android:layout_width="0dp"
                        android:layout_height="46dp"
                        android:layout_columnWeight="1"
                        android:layout_margin="4dp"
                        android:text="5%"
                        android:textStyle="bold"
                        android:textColor="#020B1A"
                        android:backgroundTint="#FFFFFF" />

                </GridLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Selected rebate will be highlighted in yellow."
                    android:textColor="#00E5FF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="15dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnCalculate"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:backgroundTint="#FFC107"
                        android:text="CALCULATE"
                        android:textColor="#000000"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <Space
                        android:layout_width="10dp"
                        android:layout_height="match_parent" />

                    <Button
                        android:id="@+id/btnReset"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:backgroundTint="#1E90FF"
                        android:text="RESET"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Calculation Result"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="16dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_dashboard_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Charges"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtTotalCharges"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 0.00"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before rebate"
                        android:textColor="#C9D4E5"
                        android:textSize="11sp" />

                </LinearLayout>

                <Space
                    android:layout_width="10dp"
                    android:layout_height="match_parent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/bg_green_card"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="8dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Final Cost"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/txtFinalCost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RM 0.00"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="17sp"
                        android:layout_marginTop="6dp" />

                    <TextView
                        android:id="@+id/txtFinalNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="After rebate"
                        android:textColor="#76FF7A"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="125dp"
                android:orientation="vertical"
                android:background="@drawable/bg_dashboard_card"
                android:padding="13dp"
                android:layout_marginTop="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Electricity Tariff"
                    android:textColor="#FFC107"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="1 - 200 kWh        RM 0.218 / kWh\n201 - 300 kWh    RM 0.334 / kWh\n301 - 600 kWh    RM 0.516 / kWh\n601 - 1000 kWh  RM 0.546 / kWh"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnSave"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="SAVE RECORD"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#22C55E"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="20dp" />

            <Button
                android:id="@+id/btnDashboard"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="BACK TO DASHBOARD"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#1E90FF"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>