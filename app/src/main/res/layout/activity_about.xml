<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B1A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="About ⚡ WattWise"
            android:textColor="#C9D4E5"
            android:textSize="14sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- STUDENT INFORMATION -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:background="@drawable/bg_dashboard_card"
            android:padding="16dp">

            <ImageView
                android:id="@+id/imgProfile"
                android:layout_width="105dp"
                android:layout_height="105dp"
                android:src="@drawable/azura"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_circle"
                android:padding="2dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp" />

            <TextView
                android:text="👤 Full Name"
                android:textColor="#1E90FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Azura Binti Jamaludin"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="🆔 Student ID"
                android:textColor="#1E90FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="2022888198"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="🎓 Course Code and Name"
                android:textColor="#1E90FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="ICT602 - Mobile Application Development"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:text="🏛 Institution"
                android:textColor="#1E90FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Universiti Teknologi MARA (UiTM)"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- HOW TO USE -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_purple_card"
            android:padding="16dp"
            android:layout_marginTop="14dp">

            <TextView
                android:text="📋 How To Use WattWise"
                android:textColor="#C084FC"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="1. Login to WattWise.\n2. Open Calculator page.\n3. Select bill month.\n4. Enter units used (kWh).\n5. Choose rebate percentage.\n6. Tap Calculate.\n7. Tap Save Record.\n8. Open History page.\n9. Tap a record to view details.\n10. Edit or delete record if needed."
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:lineSpacingExtra="5dp"
                android:layout_marginTop="10dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- GITHUB WEBSITE -->
        <LinearLayout
            android:id="@+id/btnGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_blue_card"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:text="🌐 Application Website (GitHub)"
                android:textColor="#1E90FF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Tap to open the application website:"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <TextView
                android:id="@+id/txtGithub"
                android:text="https://github.com/azurajamaludin/WattWise"
                android:textColor="#4DA3FF"
                android:textSize="12sp"
                android:layout_marginTop="6dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- COPYRIGHT -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_yellow_card"
            android:padding="16dp"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:text="🛡 Copyright"
                android:textColor="#000000"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:text="Copyright © 2026\nAzura Binti Jamaludin\n\nICT602 Mobile Application Development\nAll rights reserved."
                android:textColor="#111827"
                android:textSize="12sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>