<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bill Details"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="10dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="22dp"
            android:layout_marginTop="28dp">

            <TextView
                android:id="@+id/txtMonthYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="January 2026"
                android:textColor="#FFC107"
                android:textSize="30sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E90FF"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Usage Information"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Units Used"
                android:textColor="#C9D4E5"
                android:textSize="15sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/txtUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0 kWh"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rebate"
                android:textColor="#C9D4E5"
                android:textSize="15sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/txtRebate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="0%"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E90FF"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🧾 Billing Details"
                android:textColor="#FFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Total Charges"
                android:textColor="#C9D4E5"
                android:textSize="15sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/txtTotalCharges"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RM 0.00"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rebate Amount"
                android:textColor="#C9D4E5"
                android:textSize="15sp"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/txtRebateAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="-RM 0.00"
                android:textColor="#76FF7A"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Final Cost"
                android:textColor="#C9D4E5"
                android:textSize="15sp"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/txtFinalCost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="RM 0.00"
                android:textColor="#FFC107"
                android:textSize="36sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="EDIT RECORD"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FFC107"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="DELETE RECORD"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#EF4444"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>