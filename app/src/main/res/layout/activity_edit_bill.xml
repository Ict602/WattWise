<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#020B1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ WattWise"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_gravity="center_horizontal" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Edit Bill Record"
            android:textColor="#C9D4E5"
            android:textSize="15sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="24dp" />

        <!-- CURRENT RECORD CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_blue_card"
            android:padding="18dp">

            <TextView
                android:id="@+id/txtMonthBadge"
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:gravity="center"
                android:background="@drawable/bg_month_circle"
                android:text="JAN"
                android:textColor="#000000"
                android:textSize="18sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="14dp">

                <TextView
                    android:text="CURRENT RECORD"
                    android:textColor="#1E90FF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtCurrentRecord"
                    android:text="January 2026"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/txtCurrentCost"
                    android:text="RM 0.00"
                    android:textColor="#FFC107"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

        <!-- EDIT FORM CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_dashboard_card"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:text="Month"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spMonth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_box"
                android:popupBackground="#071426"
                android:layout_marginTop="8dp" />

            <TextView
                android:text="Units Used (kWh)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <EditText
                android:id="@+id/etUnit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:hint="Example: 350"
                android:textColor="#FFFFFF"
                android:textColorHint="#8CA0B8"
                android:textSize="14sp"
                android:inputType="number"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:background="@drawable/bg_input_box"
                android:layout_marginTop="8dp" />

            <TextView
                android:text="Rebate (%)"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <Spinner
                android:id="@+id/spRebate"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="@drawable/bg_input_box"
                android:popupBackground="#071426"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        <!-- NEW ESTIMATE CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="105dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_green_card"
            android:padding="18dp"
            android:layout_marginTop="18dp">

            <TextView
                android:layout_width="65dp"
                android:layout_height="match_parent"
                android:text="💵"
                android:textSize="38sp"
                android:gravity="center" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:text="NEW ESTIMATED BILL"
                    android:textColor="#76FF7A"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="After changes"
                    android:textColor="#C9D4E5"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtNewCost"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RM 0.00"
                android:textColor="#76FF7A"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="UPDATE RECORD"
            android:textColor="#000000"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#FFC107"
            android:layout_marginTop="22dp" />

        <Button
            android:id="@+id/btnCancel"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CANCEL"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="#1E90FF"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="30dp" />

    </LinearLayout>

</ScrollView>